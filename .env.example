FLASK_ENV=development
SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
OWNER_ACCESS_SECRET=generate-a-separate-random-secret-of-at-least-16-characters
ADMIN_SETUP_TOKEN=generate-a-separate-random-token-of-at-least-16-characters

DATA_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SEED_SAMPLE_COURSES=false

# Set these for deployment, not to localhost.
PUBLIC_BASE_URL=http://127.0.0.1:5000
TRUSTED_PROXY_COUNT=0
# Set a shared storage URL (for example Redis) when using multiple workers.
RATELIMIT_STORAGE_URI=memory://
